<h1>{{ article.title }}</h1>

<small>{{ article.author }}</small>

<time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
  {{ article.published_at | date: '%B %d, %Y' }}
</time>

{% if article.image %}
  <img
    src="{{ article.image | image_url: width: 800 }}"
    alt="{{ article.image.alt | escape }}"
    width="800"
    height="auto"
  >
{% endif %}

<div>
  {{ article.content }}
</div>